$! MKVBKS.COM - the OpenVMS BACKUP savesets of the VBACKUP tests (test/vms)
$! Run in SYS$SYSDEVICE:[LAISHEV] with TEXT.TXT, LONG.TXT, BIN.DAT and the FDLs there
$ SET NOON
$ SET PROCESS/PARSE_STYLE=EXTENDED
$ SET DEFAULT SYS$SYSDEVICE:[LAISHEV]
$ IF F$SEARCH("[.VBKS...]*.*;*") .NES. "" THEN DELETE/NOLOG [.VBKS...]*.*;*
$ IF F$SEARCH("[.VBKS]*.DIR;*") .NES. "" THEN DELETE/NOLOG [.VBKS]*.DIR;*
$ IF F$SEARCH("VBKS.DIR") .NES. "" THEN DELETE/NOLOG VBKS.DIR;*
$ CREATE/DIRECTORY [.VBKS]
$ CREATE/DIRECTORY [.VBKS.SUB]
$ CONVERT/FDL=LONG.FDL TEXT.TXT [.VBKS]VAR.TXT
$ CONVERT/FDL=LONG.FDL LONG.TXT [.VBKS]LONG.TXT
$ CONVERT/FDL=NOSPAN.FDL TEXT.TXT [.VBKS]NOSPAN.TXT
$ CONVERT/FDL=STMLF.FDL TEXT.TXT [.VBKS]STMLF.TXT
$ CONVERT/FDL=STM.FDL TEXT.TXT [.VBKS]STM.TXT
$ CONVERT/FDL=STMCR.FDL TEXT.TXT [.VBKS]STMCR.TXT
$ CONVERT/FDL=VFC.FDL TEXT.TXT [.VBKS]VFC.TXT
$ CONVERT/FDL=FIX80.FDL/PAD/TRUNCATE TEXT.TXT [.VBKS]FIX80.TXT
$ CONVERT/FDL=IDX.FDL/PAD TEXT.TXT [.VBKS]IDX.DAT
$ COPY BIN.DAT [.VBKS]BIN.DAT
$ COPY BIN.DAT [.VBKS]UDF.DAT
$ SET FILE/ATTRIBUTE=(RFM:UDF,RAT:NONE) [.VBKS]UDF.DAT
$ CREATE [.VBKS]EMPTY.DAT
$ COPY [.VBKS]VAR.TXT [.VBKS.SUB]V.TXT
$ COPY [.VBKS]STMLF.TXT [.VBKS.SUB]V.TXT
$ COPY [.VBKS]VAR.TXT [.VBKS]Mixed^_Case.txt
$ COPY [.VBKS]VAR.TXT [.VBKS]a^.b^.c.txt
$ BACKUP [LAISHEV.VBKS...]*.*;* VBKS1.BCK/SAVE_SET/BLOCK_SIZE=8192/GROUP_SIZE=5
$ BACKUP [LAISHEV.VBKS...]*.*;* VBKS2.BCK/SAVE_SET/BLOCK_SIZE=8192/NOCRC/GROUP_SIZE=0
$ BACKUP [LAISHEV.VBKS...]*.*;* VBKS3.BCK/SAVE_SET
$ BACKUP/LIST=VBKS1.LIS/FULL VBKS1.BCK/SAVE_SET
$ BACKUP/LIST=VBKS2.LIS VBKS2.BCK/SAVE_SET
$ DIRECTORY [.VBKS...]
$ DIRECTORY/SIZE=ALL VBKS%.BCK
$ EXIT
